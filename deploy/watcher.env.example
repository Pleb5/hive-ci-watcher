# Install the built checkout (including node_modules) at /opt/hive-ci-watcher.
# The service also requires /usr/bin/node and git on its PATH.
HIVE_CI_WATCHER_OWNER_PUBKEY=<operator-hex-or-npub>
HIVE_CI_WATCHER_COMMUNITIES_FILE=/etc/hive-ci-watcher/communities.json
# Community configuration is optional. Omitted service roles derive from its
# signed infrastructure. Standalone deployments must supply inbox and outbox:
# HIVE_CI_WATCHER_INBOX_RELAYS=wss://inbox.example.com
# HIVE_CI_WATCHER_OUTBOX_RELAYS=wss://outbox.example.com
# HIVE_CI_WATCHER_BLOSSOM_SERVERS=https://blossom.example.com
# HIVE_CI_WATCHER_RELAYS is an explicit shorthand overriding both service roles.
# Empty optional discovery lists disable that path; these are metadata-only:
# HIVE_CI_WATCHER_IDENTITY_DISCOVERY_RELAYS=wss://purplepag.es
# HIVE_CI_WATCHER_GIT_DISCOVERY_RELAYS=wss://index.ngit.dev
# HIVE_CI_WATCHER_SERVICE_DISCOVERY_RELAYS=wss://relay.contextvm.org,wss://relay2.contextvm.org
HIVE_CI_WATCHER_LOG_LEVEL=info
# The unit generates a persistent private key inside its StateDirectory.
