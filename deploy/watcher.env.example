# Install the built checkout (including node_modules) at /opt/hive-ci-watcher.
# The service also requires /usr/bin/node and git on its PATH.
HIVE_CI_WATCHER_OWNER_PUBKEY=<operator-hex-or-npub>
HIVE_CI_WATCHER_COMMUNITIES_FILE=/etc/hive-ci-watcher/communities.json
HIVE_CI_WATCHER_LOG_LEVEL=info
# The unit generates a persistent private key inside its StateDirectory.
